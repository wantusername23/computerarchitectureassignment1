{
    "build": {
        "dockerfile": "../dockerfiles/Dockerfile",
        "context": ".."
    },

    "hostRequirements": {
        "cpus": 4,
        "memory": "8gb",
        "storage": "32gb"
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "aaronduino.chisel"
            ],

            "settings": {
                "terminal.integrated.profiles.linux": {
                    "sbt (dinocpu)": {
                        "path": "/usr/bin/sbt",
                        "args": ["-mem", "3096"]
                    }
                },
                "terminal.integrated.defaultProfile.linux": "bash"
            }
        }
    },

    "postCreateCommand": "sbt compile"
}